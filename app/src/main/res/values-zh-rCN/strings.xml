    <!-- OEM battery guide -->
    <string name="oem_xiaomi_title">小米/MIUI 电池设置</string>
    <string name="oem_xiaomi_desc">MIUI 会激进地清理后台应用。请按以下步骤操作：</string>
    <string name="oem_xiaomi_step1">1. 设置 > 应用 > 应用管理 > Blink > 自启动 > 开启</string>
    <string name="oem_xiaomi_step2">2. 设置 > 应用 > 应用管理 > Blink > 省电策略 > 无限制</string>
    <string name="oem_xiaomi_step3">3. 安全中心 > 电池 > 应用省电策略 > Blink > 无限制</string>
    <string name="oem_xiaomi_step4">4. 在多任务界面锁定 Blink（在应用卡片上向下滑动）</string>
    <string name="oem_xiaomi_note">注意：若系统强行停止 Blink，开机自启动在手动打开一次应用前不会生效。</string>

    <string name="oem_samsung_title">三星电池设置</string>
    <string name="oem_samsung_desc">三星的电池优化可能会停止后台应用。请按以下步骤操作：</string>
    <string name="oem_samsung_step1">1. 设置 > 电池 > 后台使用限制 > 从不休眠的应用 > 添加 Blink</string>
    <string name="oem_samsung_step2">2. 设置 > 应用 > Blink > 电池 > 无限制</string>
    <string name="oem_samsung_step3">3. 在多任务界面锁定 Blink（点按应用图标 > 锁定）</string>
    <string name="oem_samsung_note">注意：若系统强行停止 Blink，开机自启动在手动打开一次应用前不会生效。</string>

    <string name="oem_huawei_title">华为/荣耀电池设置</string>
    <string name="oem_huawei_desc">EMUI 的电源管理较为激进。请按以下步骤操作：</string>
    <string name="oem_huawei_step1">1. 设置 > 电池 > 应用启动管理 > Blink > 手动管理 > 开启全部开关</string>
    <string name="oem_huawei_step2">2. 设置 > 应用 > 应用 > Blink > 耗电详情 > 开启「允许后台活动」</string>
    <string name="oem_huawei_step3">3. 在多任务界面锁定 Blink（在应用卡片上向下滑动）</string>

    <string name="oem_oppo_title">OPPO/Realme/一加电池设置</string>
    <string name="oem_oppo_desc">ColorOS 会激进地管理后台应用。请按以下步骤操作：</string>
    <string name="oem_oppo_step1">1. 设置 > 应用管理 > 应用列表 > Blink > 自启动 > 允许</string>
    <string name="oem_oppo_step2">2. 设置 > 电池 > 更多设置 > 优化电池使用 > Blink > 不优化</string>
    <string name="oem_oppo_step3">3. 设置 > 应用 > 应用管理 > Blink > 电池用量 > 允许后台活动</string>
    <string name="oem_oppo_step4">4. 在多任务界面锁定 Blink（点按应用卡片上的锁图标）</string>
    <string name="oem_oppo_note">注意：若系统强行停止 Blink，开机自启动在手动打开一次应用前不会生效。</string>

    <string name="oem_vivo_title">vivo/iQOO 电池设置</string>
    <string name="oem_vivo_desc">Funtouch OS 会限制后台应用。请按以下步骤操作：</string>
    <string name="oem_vivo_step1">1. 设置 > 应用 > 自启动 > 开启 Blink</string>
    <string name="oem_vivo_step2">2. 设置 > 电池 > 后台耗电管理 > Blink > 不限制</string>
    <string name="oem_vivo_step3">3. 设置 > 应用 > Blink > 电池 > 允许高耗电后台运行</string>
    <string name="oem_vivo_step4">4. 在多任务界面锁定 Blink（在应用卡片上向下滑动）</string>
    <string name="oem_vivo_note">注意：若系统强行停止 Blink，开机自启动在手动打开一次应用前不会生效。</string>

    <string name="oem_motorola_title">摩托罗拉电池设置</string>
    <string name="oem_motorola_desc">摩托罗拉的系统仍可能终止前台服务。请按以下步骤操作：</string>
    <string name="oem_motorola_step1">1. 设置 > 电池 > 电池优化 > 所有应用 > Blink > 不优化</string>
    <string name="oem_motorola_step2">2. 设置 > 应用 > Blink > 电池 > 允许后台活动</string>
    <string name="oem_motorola_step3">3. 设置 > 电池 > 自适应电池 > 关闭（可选，会影响所有应用）</string>
    <string name="oem_motorola_note">注意：若系统强行停止 Blink，开机自启动在手动打开一次应用前不会生效。</string>

    <string name="oem_asus_title">华硕电池设置</string>
    <string name="oem_asus_desc">华硕的电源管理可能会限制后台应用。请按以下步骤操作：</string>
    <string name="oem_asus_step1">1. 设置 > 电池 > PowerMaster > 电池优化 > Blink > 不优化</string>
    <string name="oem_asus_step2">2. 设置 > 电池 > PowerMaster > 自启动管理 > 开启 Blink</string>

    <string name="oem_nokia_title">诺基亚电池设置</string>
    <string name="oem_nokia_desc">诺基亚使用 DuraSpeed，会限制后台进程。请按以下步骤操作：</string>
    <string name="oem_nokia_step1">1. 设置 > 电池 > 后台活动 > 开启 Blink</string>
    <string name="oem_nokia_step2">2. 设置 > 应用 > Blink > 电池 > 无限制</string>

